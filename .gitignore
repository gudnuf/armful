# armful is public. Nothing real goes in git: no photos, no faces, no built
# page data, no per-collection config, no secrets. bin/check-no-private.sh
# enforces the same rules (and more) before every push.

# built output and page data
dist/
**/data.json
**/hidden.json
**/merges.json
**/faces.json

# per-collection config: only the placeholder example is committed
collections/*/
!collections/example/
# local env files (real paths), even inside the example
**/local.env

# scan output, photos, video (any case): every type the pipeline reads, and more
*.[tT][sS][vV]
*.[nN][pP][yY]
*.[nN][pP][zZ]
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
*.[pP][nN][gG]
*.[gG][iI][fF]
*.[hH][eE][iI][cC]
*.[hH][eE][iI][fF]
*.[aA][vV][iI][fF]
*.[dD][nN][gG]
*.[wW][eE][bB][pP]
*.[tT][iI][fF]
*.[tT][iI][fF][fF]
*.[bB][mM][pP]
*.[rR][aA][wW]
*.[cC][rR]2
*.[cC][rR]3
*.[nN][eE][fF]
*.[aA][rR][wW]
*.[oO][rR][fF]
*.[rR][wW]2
*.[mM][oO][vV]
*.[mM][pP]4
*.[mM]4[vV]
*.[aA][vV][iI]
*.[mM][kK][vV]
*.[wW][eE][bB][mM]
*.3[gG][pP]
*.[mM][tT][sS]

# face crops, scan data, screenshots, local state, at any depth
crops/
pipeline/**/data/
shots/
state/

# secrets and tooling
.dev.vars
.wrangler/
node_modules/
.venv/
__pycache__/

# generated by bin/make-fixture.py in tests
test/fixture/

# allow-list: self-hosted fonts, the page's own svg, and the home page's two
# generated cards (bin/make-og.mjs: a wordmark on paper, no photo, no face)
!site/fonts/*.woff2
!site/*.svg
!home/og/*.png
